      "use_huber_loss": true,
      "use_policy_active_masks": true,
      "huber_delta": 10.0,
      "action_aggregation": "prod",
      "share_param": false,
      "fixed_order": false
    },
    "logger": {
      "log_dir": "./results"
    }
  },
